# ─── Contoh Konfigurasi Persekitaran ─────────────────────────────────────
# Salin fail ini sebagai .env dan isi dengan nilai sebenar anda.
# JANGAN komit fail .env ke GitHub — ia mengandungi kredensial sensitif.

# Pangkalan data Supabase (PostgreSQL)
# Dapatkan dari: Supabase Dashboard → Project Settings → Database → Connection string
# Format pooler (session mode, port 5432) — disyorkan untuk Prisma
# Format: postgresql://postgres.{PROJECT_REF}:{PASSWORD}@aws-0-{REGION}.pooler.supabase.com:5432/postgres?schema=public
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?schema=public

# Supabase project config (untuk integrasi masa hadapan)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
